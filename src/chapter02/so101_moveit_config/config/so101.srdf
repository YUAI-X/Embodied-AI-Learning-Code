<?xml version="1.0"?>
<robot name="so101">
  <!-- 固定虚拟关节用于把机器人基座连接到 MoveIt 的 world。 -->
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>
  <group name="gripper">
    <joint name="gripper"/>
  </group>
  <end_effector name="so101_gripper" parent_link="gripper_link" group="gripper"/>

  <group_state name="home" group="arm">
    <joint name="shoulder_pan" value="0.0"/>
    <joint name="shoulder_lift" value="-0.45"/>
    <joint name="elbow_flex" value="0.90"/>
    <joint name="wrist_flex" value="-0.45"/>
    <joint name="wrist_roll" value="0.0"/>
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="shoulder_pan" value="0.15"/>
    <joint name="shoulder_lift" value="-0.70"/>
    <joint name="elbow_flex" value="1.15"/>
    <joint name="wrist_flex" value="-0.35"/>
    <joint name="wrist_roll" value="0.0"/>
  </group_state>
  <group_state name="carry" group="arm">
    <joint name="shoulder_pan" value="-0.35"/>
    <joint name="shoulder_lift" value="-0.35"/>
    <joint name="elbow_flex" value="0.75"/>
    <joint name="wrist_flex" value="-0.25"/>
    <joint name="wrist_roll" value="0.0"/>
  </group_state>
  <group_state name="open" group="gripper"><joint name="gripper" value="0.8"/></group_state>
  <group_state name="closed" group="gripper"><joint name="gripper" value="0.0"/></group_state>

  <!-- 相邻 Link 在正常状态下会接触，禁用这些碰撞对可减少无意义检查。 -->
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="lower_arm_link" reason="Adjacent"/>
  <disable_collisions link1="lower_arm_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="moving_jaw_so101_v1_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="camera_link" reason="Adjacent"/>
</robot>
